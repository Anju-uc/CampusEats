PORT=5000

MONGODB_URI=
MONGODB_DB_NAME=campuseats

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=https://campuseats-dffc0-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_WEB_API_KEY=

# Required by server-side campus proof verification.
# Keep both values secret/server-only; never place them in Flutter.
CAMPUS_ACCESS_SECRET=
CAMPUS_ID=pes-bangalore

# Razorpay payment gateway credentials
# RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET must remain server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cashfree Sandbox / Payment Gateway credentials
# CASHFREE_CLIENT_SECRET must remain server-side only.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01